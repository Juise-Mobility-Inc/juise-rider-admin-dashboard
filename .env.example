VITE_AUTH_APP_ID=juise_rider_admin_dashboard
VITE_DEFAULT_MANAGED_APP_ID=juise-customer-app

VITE_PORT=5174
VITE_PREVIEW_PORT=4174

VITE_API_BASE=/kca-api

# The KCA target is normally selected from the Git branch:
# qa and feature branches -> https://qa-kca-proxy.juisemobility.com
# main/prod/production    -> https://kca-proxy.juisemobility.com
# Set these only when an explicit override is needed.
# VITE_DEPLOYMENT_ENV=qa
# VITE_GIT_BRANCH=qa
# VITE_KCA_PROXY_TARGET=http://localhost:8088

# Optional: enables Google Places location suggestions in the school zone map editor.
# Restrict this browser key to your dashboard domain and enable Places API (New).
VITE_GOOGLE_MAPS_API_KEY=
